# Copy this file to .env and fill in your values for local development
# Never commit .env to git

# PostgreSQL connection string (Render provides this automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/wedding

# Secret used to sign session cookies — use a long random string
SESSION_SECRET=replace-me-with-a-long-random-secret

# Plain-text password for the wedding planner dashboard
# This is hashed with bcrypt on first boot and never stored plain
DASHBOARD_PASSWORD=your-dashboard-password-here

# Port (Render sets this automatically; 3000 is the local default)
PORT=3000
